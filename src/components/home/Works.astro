---
import { PROJECTS } from "../../data/projects";
---

<section id="trabalhos" class="relative bg-ink px-6 py-28 md:px-10">
  <div class="mx-auto max-w-site">
    <div class="mb-12" data-fade-up>
      <span class="font-mono text-2xs tracking-caps text-vermillion">[PROJETO REAL]</span>
      <h2 class="mt-2 font-display text-section-title text-cream">
        DO PLANO <span class="text-vermillion">À ENTREGA.</span>
      </h2>
    </div>
    {PROJECTS.map((project) => (
      <article class="grid gap-10 border border-cream-ghost p-8 md:grid-cols-2 md:p-12" data-fade-up>
        <div>
          <span class="font-mono text-xs tracking-wider text-vermillion">{project.category}</span>
          <h3 class="mt-4 font-display text-[clamp(2rem,5vw,4rem)] leading-none text-cream">{project.title}</h3>
          <p class="mt-6 max-w-text font-mono text-sm leading-relaxed text-cream-fade">{project.description}</p>
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block font-mono text-sm text-vermillion underline underline-offset-4">
            Visitar site do projeto ↗<span class="sr-only"> (abre em nova aba)</span>
          </a>
        </div>
        <dl class="space-y-6 font-mono text-sm leading-relaxed">
          <div><dt class="text-cream">Contexto</dt><dd class="mt-2 text-cream-fade">Apresentação comercial de embalagens industriais na web.</dd></div>
          <div><dt class="text-cream">Entrega visível</dt><dd class="mt-2 text-cream-fade">Páginas de produtos, especificações e acesso ao atendimento pelo WhatsApp.</dd></div>
          <div><dt class="text-cream">Escopo apresentado</dt><dd class="mt-2 text-cream-fade">Site comercial voltado à apresentação dos produtos e ao contato com a equipe de vendas.</dd></div>
        </dl>
      </article>
    ))}
  </div>
</section>
